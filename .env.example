# Local dev (Dockerized PostgreSQL from docker-compose.yml, host port 5435)
DB_URL=jdbc:postgresql://localhost:5435/erp
DB_USERNAME=erp_user
DB_PASSWORD=<choose-a-local-db-password>

# Cloud alternative (e.g. Neon):
# DB_URL=jdbc:postgresql://<your-neon-host>/<your-database>?sslmode=require

# Generate with: openssl rand -base64 48
JWT_SECRET=<your-strong-jwt-secret>
